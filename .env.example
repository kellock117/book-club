# 복사해서 .env.local로 쓴다. 이 파일에는 실제 값을 넣지 않는다.
# NEXT_PUBLIC_ 접두사는 어떤 변수에도 붙이지 않는다 (키는 서버에만 둔다).

# Supabase (서버 전용)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 사이트 잠금
SITE_PASSWORD=
ADMIN_PASSWORD=

# 책 검색
ALADIN_TTB_KEY=
KAKAO_REST_API_KEY=

# 크론 호출 검증 (Vercel Cron)
CRON_SECRET=

# 노션 이전 스크립트에서만 사용. 이전이 끝나면 통합을 삭제한다
NOTION_TOKEN=
